{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pAulseperformance/hedge-core/coverage.schema.json",
  "title": "hedge-core coverage artifact",
  "description": "Published decision for the insurance leg. Consumed as DATA by other projects (dashboard, MM bot, scanners, research). Bump schema_version on any breaking change.",
  "type": "object",
  "required": ["schema_version", "produced_by", "plan"],
  "properties": {
    "schema_version": { "const": 1 },
    "produced_by": { "type": "string" },
    "read_only": {
      "type": "boolean",
      "description": "Always true. This artifact is a decision, never an executed order."
    },
    "policy": { "type": "object" },
    "plan": {
      "type": "object",
      "required": ["exposure_usd", "target_ratio", "covered_usd", "coverage_pct",
                   "is_covered", "legs", "notes"],
      "properties": {
        "exposure_usd": { "type": "number" },
        "target_ratio": { "type": "number" },
        "covered_usd": { "type": "number" },
        "uncovered_usd": { "type": "number" },
        "coverage_pct": { "type": "number" },
        "is_covered": { "type": "boolean" },
        "burned_off": {
          "type": "boolean",
          "description": "A policy trigger fires and the correct hedge is zero. A decision, not an absence of one."
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mechanism", "notional_usd", "cost_bps"],
            "properties": {
              "mechanism": { "enum": ["perp_short", "long_put"] },
              "notional_usd": { "type": "number" },
              "cost_bps": { "type": "number" },
              "caps_upside": { "type": "boolean" },
              "has_liquidation_risk": { "type": "boolean" },
              "rationale": { "type": "string" }
            }
          }
        },
        "triggers": { "type": "array", "items": { "type": "string" } },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Mandatory when is_covered is false: every unavailable mechanism states why."
        }
      }
    }
  }
}
